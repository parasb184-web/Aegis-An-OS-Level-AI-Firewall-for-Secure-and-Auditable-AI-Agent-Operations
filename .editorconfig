# EditorConfig — https://editorconfig.org
# Ensures consistent formatting across all editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
max_line_length = 100

[*.sql]
indent_size = 4

[*.sh]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.html]
indent_size = 2

[Makefile]
indent_style = tab
